# DB 연결 주소 (실제 비밀번호는 .env에만 넣고 커밋하지 않음)
# 호스트는 localhost 대신 127.0.0.1 (Windows에서 IPv6로 먼저 붙다가 멈출 수 있음, T-002)
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@127.0.0.1:5432/didim

# 세션 쿠키 서명용 비밀키 (32자 이상 무작위 문자열을 .env에 직접 설정)
# 아래 예시 값은 일부러 32자보다 짧다. 복사만 하고 바꾸지 않으면 로그인 요청이 실패해서,
# 공개된 문자열이 실제 서명 키로 쓰이는 일을 막는다. 만드는 법(backend 폴더에서):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME

# 구글 OAuth 설정 (Google Cloud Console에서 발급받은 값을 .env에 설정)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 로그인 완료 · 실패 시 돌아갈 화면 주소
FRONTEND_URL=http://localhost:3000

# 운영(HTTPS)에서는 true, 로컬(HTTP)에서는 false
COOKIE_SECURE=false

# 구글 로그인을 받을 이메일(쉼표로 여러 개, F-015 · D-031). 비우면 누구나 로그인(로컬 개발용).
# 공개 배포에서는 꼭 채운다 — 그 밖의 사람은 샘플 체험만 쓴다. 운영(COOKIE_SECURE=true, 또는 https · localhost가 아닌
# FRONTEND_URL · GOOGLE_REDIRECT_URI)에서 비어 있으면 서버가 시작하지 않는다.
ALLOWED_LOGIN_EMAILS=

# LLM (D-014 · D-027) — mock(기본, 키 없이 가짜 AI) | exaone | local | nvidia
# 연결 확인(backend 폴더에서): uv run --env-file .env python -m scripts.llm_ping exaone
LLM_PROVIDER=mock

# K-EXAONE 2.5 (서버에서만 사용, 화면 쪽 .env나 NEXT_PUBLIC_에 넣지 않음). 실제 키는 .env에만.
EXAONE_API_KEY=your-exaone-api-key

# NVIDIA 무료 API(D-027, build.nvidia.com — 개발자 가입 + 휴대폰 인증 후 키 발급). 서버에서만, 실제 키는 .env에만.
# 모델은 카탈로그에서 'Free Endpoint' 표시가 붙은 것만 무료 — 이름을 그대로 적어요(D-027: 메인 Ultra · 예비 Bolt).
# 입력 · 출력이 NVIDIA에 기록될 수 있어요(체험판 약관) — 타인 개인정보는 보내지 않아요(D-014와 같은 기준).
# 연결 확인: uv run --env-file .env python -m scripts.llm_ping nvidia
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# 예비(Ultra가 느리거나 응답이 없을 때): nvidia/nemotron-3.5-bolt-e4b

# 아래는 바꿀 때만 주석을 풀어요.
# local이면 LLM_MODEL은 꼭 필요(예: Ollama에 내려받은 모델 이름), 주소 기본값은 이 컴퓨터의 Ollama(127.0.0.1:11434)
# Ollama를 다른 컴퓨터(예: 집 데스크톱)에서 켜면 그 컴퓨터 주소를 넣어요(예: http://<데스크톱 IP>:11434/v1).
# LLM_BASE_URL은 local일 때만 읽어요(키를 보내지 않아서 http 주소도 돼요). exaone · nvidia는 공식 주소 고정.
# LLM_BASE_URL=
# LLM_MODEL=
# EXAONE은 low(기본) | high | max
# LLM_REASONING_EFFORT=
# 응답을 기다리는 최대 시간(초, 기본 60)
# LLM_TIMEOUT_SECONDS=
