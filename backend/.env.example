# DB 연결 주소 (실제 비밀번호는 .env에만 넣고 커밋하지 않음)
# 호스트는 localhost 대신 127.0.0.1 (Windows에서 IPv6로 먼저 붙다가 멈출 수 있음, T-002)
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@127.0.0.1:5432/didim

# 세션 쿠키 서명용 비밀키 (32자 이상 무작위 문자열을 .env에 직접 설정)
# 아래 예시 값은 일부러 32자보다 짧다. 복사만 하고 바꾸지 않으면 로그인 요청이 실패해서,
# 공개된 문자열이 실제 서명 키로 쓰이는 일을 막는다. 만드는 법(backend 폴더에서):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME

# 구글 OAuth 설정 (Google Cloud Console에서 발급받은 값을 .env에 설정)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 로그인 완료 · 실패 시 돌아갈 화면 주소
FRONTEND_URL=http://localhost:3000

# 운영(HTTPS)에서는 true, 로컬(HTTP)에서는 false
COOKIE_SECURE=false

# LLM — K-EXAONE 2.5 (서버에서만 사용, 화면 쪽 .env나 NEXT_PUBLIC_에 넣지 않음). 실제 키는 .env에만.
EXAONE_API_KEY=your-exaone-api-key
