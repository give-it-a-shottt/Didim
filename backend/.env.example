# DB 연결 주소 (실제 비밀번호는 .env에만 넣고 커밋하지 않음)
# 호스트는 localhost 대신 127.0.0.1 (Windows에서 IPv6로 먼저 붙다가 멈출 수 있음, T-002)
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@127.0.0.1:5432/didim

# 세션 쿠키 서명용 비밀키 (32자 이상 무작위 문자열을 .env에 직접 설정)
# 아래 예시 값은 일부러 32자보다 짧다. 복사만 하고 바꾸지 않으면 로그인 요청이 실패해서,
# 공개된 문자열이 실제 서명 키로 쓰이는 일을 막는다. 만드는 법(backend 폴더에서):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME

# 구글 OAuth 설정 (Google Cloud Console에서 발급받은 값을 .env에 설정)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 로그인 완료 · 실패 시 돌아갈 화면 주소
FRONTEND_URL=http://localhost:3000

# 운영(HTTPS)에서는 true, 로컬(HTTP)에서는 false
COOKIE_SECURE=false

# LLM (D-014) — mock(기본, 키 없이 가짜 AI) | exaone | local
# 연결 확인(backend 폴더에서): uv run --env-file .env python -m scripts.llm_ping exaone
LLM_PROVIDER=mock

# K-EXAONE 2.5 (서버에서만 사용, 화면 쪽 .env나 NEXT_PUBLIC_에 넣지 않음). 실제 키는 .env에만.
EXAONE_API_KEY=your-exaone-api-key

# 아래는 바꿀 때만 주석을 풀어요.
# local이면 LLM_MODEL은 꼭 필요(예: Ollama에 내려받은 모델 이름), 주소 기본값은 이 컴퓨터의 Ollama(127.0.0.1:11434)
# Ollama를 다른 컴퓨터(예: 집 데스크톱)에서 켜면 그 컴퓨터 주소를 넣어요(예: http://<데스크톱 IP>:11434/v1).
# local은 키를 보내지 않아서 http 주소도 돼요. 키가 있는 exaone은 https만 받아요.
# LLM_BASE_URL=
# LLM_MODEL=
# EXAONE은 low(기본) | high | max
# LLM_REASONING_EFFORT=
# 응답을 기다리는 최대 시간(초, 기본 60)
# LLM_TIMEOUT_SECONDS=
